+namespace recomb_dp {
+static const char *env(const char *k) { const char *v = getenv(k); return (v && *v) ? v : nullptr; }
+static bool flag(const char *k) { const char *v = env(k); return v && v[0] != '0'; }
+static const uint64_t FNV0 = 1469598103934665603ULL;
+static inline uint64_t fnv(uint64_t h, int64_t x) {
+    uint64_t u = (uint64_t)x;
+    for (int b = 0; b < 8; ++b) { h ^= (u >> (8 * b)) & 0xff; h *= 1099511628211ULL; }
+    return h;
+}
+static inline int64_t now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+static FILE *open_append(const char *k) {
+    const char *p = env(k);
+    if (!p) return nullptr;
+    FILE *fp = fopen(p, "a");
+    if (!fp) { perror(k); exit(2); }
+    return fp;
+}
+static long full_left = -2;
+}
